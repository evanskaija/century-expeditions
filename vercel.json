{
  "buildCommand": "npm run build:knowledge",
  "outputDirectory": ".",
  "functions": {
    "api/assistant.js": {
      "includeFiles": "assistant-knowledge.json"
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://www.century-adventures.com/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "century-adventures.com"
        }
      ]
    }
  ]
}
